# ============================================================
# INTELLI-CI — Environment Configuration Template
# Copy this file to backend/.env and fill in your real values.
# NEVER commit backend/.env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/intellici
# SQLite fallback (auto-used when PostgreSQL is unavailable):
# DATABASE_URL=sqlite+aiosqlite:///./test.db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── GitHub Integration & OAuth 2.0 ────────────────────────────
# Register an OAuth App at https://github.com/settings/developers
# Set Authorization callback URL to: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback
GITHUB_WEBHOOK_SECRET=
# Optional: personal access token for extra API calls
GITHUB_TOKEN=

# ── Application ───────────────────────────────────────────────
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Worker ────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
SYNC_BATCH_SIZE=100
